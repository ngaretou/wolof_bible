[{"style":"s1","verse":"","text":"Israel Rejects the Good"},{"style":"sd0","verse":"1","text":""},{"style":"q1","verse":"1","text":""},{"style":"v","verse":"1","text":"\\add Put\\add* to your lips \\add the\\add* trumpet"},{"style":"q1","verse":"1","text":"like a vulture over the house of Yahweh,"},{"style":"q1","verse":"1","text":"because they have ˻broken my covenant˼\\f + \\fr 8:1 \\ft Literally “transgressed my covenant” \\f*"},{"style":"q2","verse":"1","text":"and rebelled against my law."},{"style":"q1","verse":"2","text":""},{"style":"v","verse":"2","text":"They cry out to me,"},{"style":"q2","verse":"2","text":"“My God! We, Israel, know you!”"},{"style":"q1","verse":"3","text":""},{"style":"v","verse":"3","text":"Israel has spurned \\add the\\add* good;"},{"style":"q2","verse":"3","text":"\\add the\\add* enemy will pursue him."},{"style":"q1","verse":"4","text":""},{"style":"v","verse":"4","text":"They appointed kings, but not through me;"},{"style":"q2","verse":"4","text":"they made officials, but without my knowledge."},{"style":"q1","verse":"4","text":"\\add With\\add* their silver and gold"},{"style":"q2","verse":"4","text":"they made idols for themselves"},{"style":"q3","verse":"4","text":"for their\\f + \\fr 8:4 \\ft Hebrew “his” \\f* own ˻destruction˼.\\f + \\fr 8:4 \\ft Literally “cut off” \\f*"},{"style":"q1","verse":"5","text":""},{"style":"v","verse":"5","text":"Your calf is rejected,\\f + \\fr 8:5 \\ft Hebrew “he rejects” or “has rejected you” \\f* \\add O\\add* Samaria;"},{"style":"q2","verse":"5","text":"my anger burns against them."},{"style":"q1","verse":"5","text":"How long\\f + \\fr 8:5 \\ft Hebrew “Until when” \\f* will they be incapable of innocence?"},{"style":"q2","verse":"6","text":""},{"style":"v","verse":"6","text":"Because \\add it is\\add* from Israel,"},{"style":"q1","verse":"6","text":"an artisan made it,"},{"style":"q2","verse":"6","text":"it \\add is\\add* not a god;"},{"style":"q1","verse":"6","text":"for the calf of Samaria"},{"style":"q2","verse":"6","text":"will be broken \\add to\\add* pieces."},{"style":"q1","verse":"7","text":""},{"style":"v","verse":"7","text":"Because they sow the wind,"},{"style":"q2","verse":"7","text":"they will reap the whirlwind."},{"style":"q1","verse":"7","text":"\\add The\\add* standing grain does not have heads;\\f + \\fr 8:7 \\ft Hebrew “head” \\f*"},{"style":"q2","verse":"7","text":"it will not yield flour."},{"style":"q1","verse":"7","text":"\\add And\\add* if it would yield,"},{"style":"q2","verse":"7","text":"strangers would devour it."},{"style":"q1","verse":"8","text":""},{"style":"v","verse":"8","text":"Israel is swallowed up;"},{"style":"q2","verse":"8","text":"now they are among the nations,"},{"style":"q3","verse":"8","text":"like an object that no one desires."},{"style":"q1","verse":"9","text":""},{"style":"v","verse":"9","text":"For they have gone up \\add to\\add* Assyria,"},{"style":"q2","verse":"9","text":"a wild donkey alone to itself;"},{"style":"q3","verse":"9","text":"Ephraim has sold itself \\add for\\add* lovers."},{"style":"q1","verse":"10","text":""},{"style":"v","verse":"10","text":"Even though they have sold themselves to the nations,"},{"style":"q2","verse":"10","text":"now I will gather them."},{"style":"q1","verse":"10","text":"They will soon writhe"},{"style":"q2","verse":"10","text":"from the burden of kings\\f + \\fr 8:10 \\ft Hebrew “king” \\f* and princes."},{"style":"q1","verse":"11","text":""},{"style":"v","verse":"11","text":"When Ephraim multiplied altars"},{"style":"q2","verse":"11","text":"to expiate sins,"},{"style":"q3","verse":"11","text":"they became to him altars to sin \\add on\\add*."},{"style":"q1","verse":"12","text":""},{"style":"v","verse":"12","text":"I write for him myriads of my instruction;\\f + \\fr 8:12 \\ft Or “my law” \\f*"},{"style":"q2","verse":"12","text":"they are regarded as a strange thing."},{"style":"q1","verse":"13","text":""},{"style":"v","verse":"13","text":"They offer sacrifices of my choice\\f + \\fr 8:13 \\ft Hebrew uncertain; or “loved ones” \\f*"},{"style":"q2","verse":"13","text":"and they eat flesh;"},{"style":"q3","verse":"13","text":"Yahweh does not accept them."},{"style":"q1","verse":"13","text":"Now he will remember their iniquity"},{"style":"q2","verse":"13","text":"and punish their sins;"},{"style":"q1","verse":"13","text":"they will return \\add to\\add* Egypt."},{"style":"q2","verse":"14","text":""},{"style":"v","verse":"14","text":"Israel has forgotten his maker and built palaces,"},{"style":"q1","verse":"14","text":"and Judah has multiplied fortified cities;"},{"style":"q2","verse":"14","text":"but I will send fire on his cities"},{"style":"q2","verse":"14","text":"and it will devour her strongholds."},{"style":"sd0","verse":"","text":""}]