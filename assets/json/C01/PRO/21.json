[{"style":"q1","verse":"1","text":""},{"style":"v","verse":"1","text":"Xolu buur walum ndox la ci loxol Aji Sax ji,"},{"style":"q1","verse":"1","text":"fu ko soob mu jëme ko fa."},{"style":"b","verse":"2","text":""},{"style":"q1","verse":"2","text":""},{"style":"v","verse":"2","text":"Lu waay def, daa jub ca moom,"},{"style":"q1","verse":"2","text":"waaye Aji Sax jeey natt xol yi."},{"style":"b","verse":"3","text":""},{"style":"q1","verse":"3","text":""},{"style":"v","verse":"3","text":"Deel def dëgg ak lu jub,"},{"style":"q1","verse":"3","text":"moo gënal Aji Sax ji ab sarax."},{"style":"b","verse":"4","text":""},{"style":"q1","verse":"4","text":""},{"style":"v","verse":"4","text":"Xeebaateek réy-réylu"},{"style":"q1","verse":"4","text":"mooy bàkkaar yi ñuy ràññee ku bon."},{"style":"b","verse":"5","text":""},{"style":"q1","verse":"5","text":""},{"style":"v","verse":"5","text":"Farlu, woomle;"},{"style":"q1","verse":"5","text":"ku gaawtu, mujj néewle."},{"style":"b","verse":"6","text":""},{"style":"q1","verse":"6","text":""},{"style":"v","verse":"6","text":"Alal ju la fen may,"},{"style":"q1","verse":"6","text":"cóolóol la, day naaw, wut ko xaru la."},{"style":"b","verse":"7","text":""},{"style":"q1","verse":"7","text":""},{"style":"v","verse":"7","text":"Coxor day sànk boroom,"},{"style":"q1","verse":"7","text":"ndax day baña def njub."},{"style":"b","verse":"8","text":""},{"style":"q1","verse":"8","text":""},{"style":"v","verse":"8","text":"Ab saay-saay day dëngal,"},{"style":"q1","verse":"8","text":"nit ku dëggu di jubal."},{"style":"b","verse":"9","text":""},{"style":"q1","verse":"9","text":""},{"style":"v","verse":"9","text":"Dëkkeb ruq cim sàq"},{"style":"q1","verse":"9","text":"moo gën jabar ju pànk."},{"style":"b","verse":"10","text":""},{"style":"q1","verse":"10","text":""},{"style":"v","verse":"10","text":"Ab soxor day namma lore,"},{"style":"q1","verse":"10","text":"te du yërëm moroomam."},{"style":"b","verse":"11","text":""},{"style":"q1","verse":"11","text":""},{"style":"v","verse":"11","text":"Boo mbugalee kuy ñaawle, ab téxét jànge ca;"},{"style":"q1","verse":"11","text":"nga jàngal ku rafet xel, mu yokku."},{"style":"b","verse":"12","text":""},{"style":"q1","verse":"12","text":""},{"style":"v","verse":"12","text":"Aji Jub ji Yàlla xam na la ne ca biir kër ku bon,"},{"style":"q1","verse":"12","text":"te mooy sànk ku bon."},{"style":"b","verse":"13","text":""},{"style":"q1","verse":"13","text":""},{"style":"v","verse":"13","text":"Ku tanqamlu jooyi ku ñàkk"},{"style":"q1","verse":"13","text":"dina woote wall, wall ñàkk."},{"style":"b","verse":"14","text":""},{"style":"q1","verse":"14","text":""},{"style":"v","verse":"14","text":"Ku mer, may ko ci sutura, mu giif;"},{"style":"q1","verse":"14","text":"boroom xadar, boqal ko neexal, mu dal."},{"style":"b","verse":"15","text":""},{"style":"q1","verse":"15","text":""},{"style":"v","verse":"15","text":"Bu yoon amee, ku jub bég;"},{"style":"q1","verse":"15","text":"kuy def lu bon jàq."},{"style":"b","verse":"16","text":""},{"style":"q1","verse":"16","text":""},{"style":"v","verse":"16","text":"Ku noppee jëfe xel,"},{"style":"q1","verse":"16","text":"noppaluji njaniiw."},{"style":"b","verse":"17","text":""},{"style":"q1","verse":"17","text":""},{"style":"v","verse":"17","text":"Ku topp sa bànneex, mujje ñàkk;"},{"style":"q1","verse":"17","text":"ku sopp biiñ ak lu niin du woomle."},{"style":"b","verse":"18","text":""},{"style":"q1","verse":"18","text":""},{"style":"v","verse":"18","text":"Ku bon këppoo ayu ku baax,"},{"style":"q1","verse":"18","text":"workat gàddu musibam kuy jubal."},{"style":"b","verse":"19","text":""},{"style":"q1","verse":"19","text":""},{"style":"v","verse":"19","text":"Dëkke ndànd-foyfoy"},{"style":"q1","verse":"19","text":"moo gën jabar ju tàng, bare ay."},{"style":"b","verse":"20","text":""},{"style":"q1","verse":"20","text":""},{"style":"v","verse":"20","text":"Ku xelu denc këram ngëneeli alal aku diw,"},{"style":"q1","verse":"20","text":"ab dof saax-saaxee josam."},{"style":"b","verse":"21","text":""},{"style":"q1","verse":"21","text":""},{"style":"v","verse":"21","text":"Ku saxoo njekk ak ngor,"},{"style":"q1","verse":"21","text":"am fan wu gudd, naataangeek daraja."},{"style":"b","verse":"22","text":""},{"style":"q1","verse":"22","text":""},{"style":"v","verse":"22","text":"Ku ñaw mana daan jàmbaari dëkk bu mag,"},{"style":"q1","verse":"22","text":"ba màbb tata ja ñu yaakaaroon."},{"style":"b","verse":"23","text":""},{"style":"q1","verse":"23","text":""},{"style":"v","verse":"23","text":"Ub sa gémmiñ, moom sa làmmiñ,"},{"style":"q1","verse":"23","text":"mucc ci njàqare."},{"style":"b","verse":"24","text":""},{"style":"q1","verse":"24","text":""},{"style":"v","verse":"24","text":"Ku réy te bew, mooy ñaawle,"},{"style":"q1","verse":"24","text":"day reew, ba jéggi dayo."},{"style":"b","verse":"25","text":""},{"style":"q1","verse":"25","text":""},{"style":"v","verse":"25","text":"Ab yaafus day bëgg lu mu amul ba dee,"},{"style":"q1","verse":"25","text":"ndax du nangoo liggéey,"},{"style":"q1","verse":"26","text":""},{"style":"v","verse":"26","text":"day yendoo xemmem, te du am;"},{"style":"q1","verse":"26","text":"kay jëfe njekk di joxeeka joxewaat."},{"style":"b","verse":"27","text":""},{"style":"q1","verse":"27","text":""},{"style":"v","verse":"27","text":"Saraxu nit ku bon ñaawtéef la,"},{"style":"q1","verse":"27","text":"rawatina bu ci jubloo lu bon."},{"style":"b","verse":"28","text":""},{"style":"q1","verse":"28","text":""},{"style":"v","verse":"28","text":"Seede buy fen day sànku,"},{"style":"q1","verse":"28","text":"kuy dégg, sa kàddu sax."},{"style":"b","verse":"29","text":""},{"style":"q1","verse":"29","text":""},{"style":"v","verse":"29","text":"Ku bon day ñeme-ñemelu,"},{"style":"q1","verse":"29","text":"ku jub la muy def da koy wóor."},{"style":"b","verse":"30","text":""},{"style":"q1","verse":"30","text":""},{"style":"v","verse":"30","text":"Nit xeluwul, amulug dégg ak pexe,"},{"style":"q1","verse":"30","text":"ba manal Aji Sax ji dara."},{"style":"b","verse":"31","text":""},{"style":"q1","verse":"31","text":""},{"style":"v","verse":"31","text":"Nit ay takk, bésub xare,"},{"style":"q1","verse":"31","text":"Aji Sax ji di maye ndam."}]