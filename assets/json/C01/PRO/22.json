[{"style":"q1","verse":"1","text":""},{"style":"v","verse":"1","text":"Jëw bu rafet a gën barele,"},{"style":"q1","verse":"1","text":"wegeel gën xaalis ak wurus."},{"style":"b","verse":"2","text":""},{"style":"q1","verse":"2","text":""},{"style":"v","verse":"2","text":"Ku am ak ku ñàkk a bokk lenn:"},{"style":"q1","verse":"2","text":"Aji Sax jee leen boole sàkk."},{"style":"b","verse":"3","text":""},{"style":"q1","verse":"3","text":""},{"style":"v","verse":"3","text":"Kuy foog, gisu ay, làqu;"},{"style":"q1","verse":"3","text":"ab téxét ne ca tëñëx, loru."},{"style":"b","verse":"4","text":""},{"style":"q1","verse":"4","text":""},{"style":"v","verse":"4","text":"Woyofal te ragal Aji Sax ji,"},{"style":"q1","verse":"4","text":"am alal, gudd fan ak daraja."},{"style":"b","verse":"5","text":""},{"style":"q1","verse":"5","text":""},{"style":"v","verse":"5","text":"Yoonu njublaŋ, ay dég aki fiir;"},{"style":"q1","verse":"5","text":"ku sàmm sa bakkan sore ko."},{"style":"b","verse":"6","text":""},{"style":"q1","verse":"6","text":""},{"style":"v","verse":"6","text":"Tegal gone ciw yoon;"},{"style":"q1","verse":"6","text":"ba bu màggee, du ko wacc."},{"style":"b","verse":"7","text":""},{"style":"q1","verse":"7","text":""},{"style":"v","verse":"7","text":"Ku am ay yilif ku ñàkk,"},{"style":"q1","verse":"7","text":"koo leb di surgaam."},{"style":"b","verse":"8","text":""},{"style":"q1","verse":"8","text":""},{"style":"v","verse":"8","text":"Ku ji njubadi, góob fitna,"},{"style":"q1","verse":"8","text":"yet wa muy dóore, damm."},{"style":"b","verse":"9","text":""},{"style":"q1","verse":"9","text":""},{"style":"v","verse":"9","text":"Ku tabe am barke,"},{"style":"q1","verse":"9","text":"mooy kiy sédd ku ñàkk cib dundam."},{"style":"b","verse":"10","text":""},{"style":"q1","verse":"10","text":""},{"style":"v","verse":"10","text":"Dàqal kuy ñaawle, ay jeex;"},{"style":"q1","verse":"10","text":"xulooki saaga dakk."},{"style":"b","verse":"11","text":""},{"style":"q1","verse":"11","text":""},{"style":"v","verse":"11","text":"Ku dëggu, wax ja yiw,"},{"style":"q1","verse":"11","text":"buur di xaritam."},{"style":"b","verse":"12","text":""},{"style":"q1","verse":"12","text":""},{"style":"v","verse":"12","text":"Aji Sax jeey sàmm liy dëgg,"},{"style":"q1","verse":"12","text":"di weddi waxi fen-kat."},{"style":"b","verse":"13","text":""},{"style":"q1","verse":"13","text":""},{"style":"v","verse":"13","text":"Bul yaafus, ba naan: «Gayndee ngi ci biti,"},{"style":"q1","verse":"13","text":"dañu may rey ci mbedd mi!»"},{"style":"b","verse":"14","text":""},{"style":"q1","verse":"14","text":""},{"style":"v","verse":"14","text":"Waxi jigéenu njaalookat am yeer la,"},{"style":"q1","verse":"14","text":"ku Aji Sax ji rëbb moo cay tàbbi."},{"style":"b","verse":"15","text":""},{"style":"q1","verse":"15","text":""},{"style":"v","verse":"15","text":"Yëfi dof daa sax ci xolu gone,"},{"style":"q1","verse":"15","text":"boo bantalee, mu tàggook moom."},{"style":"b","verse":"16","text":""},{"style":"q1","verse":"16","text":""},{"style":"v","verse":"16","text":"Noot néew-ji-doole ngir yokkule,"},{"style":"q1","verse":"16","text":"mbaa may boroom alal,"},{"style":"q1","verse":"16","text":"loo ci def mu wàññi la."},{"style":"s1","verse":"","text":"Fanweeri tegtal a ngii"},{"style":"q1","verse":"17","text":""},{"style":"v","verse":"17","text":"Teewlul te déglu li boroom xel yi wax."},{"style":"q1","verse":"17","text":"Defal sam xel ci li ma lay xamal."},{"style":"q1","verse":"18","text":""},{"style":"v","verse":"18","text":"Soo mokkalee, ba man koo tari,"},{"style":"q1","verse":"18","text":"muy sa mbégte."},{"style":"q1","verse":"19","text":""},{"style":"v","verse":"19","text":"Yaw laa koy xamal tey jii,"},{"style":"q1","verse":"19","text":"ndax nga wóolu Aji Sax ji."},{"style":"q1","verse":"20","text":""},{"style":"v","verse":"20","text":"Dama laa bindal fanweeri dénkaane,"},{"style":"q1","verse":"20","text":"ci wàllu ndigal ak xam-xam,"},{"style":"q1","verse":"21","text":""},{"style":"v","verse":"21","text":"ngir xamal la lu wér te dëggu,"},{"style":"q1","verse":"21","text":"nga yóbbaale kàdduy dëgg,"},{"style":"q1","verse":"21","text":"yoo tontoo ña la yebal."},{"style":"s2","verse":"","text":"[1]"},{"style":"q1","verse":"22","text":""},{"style":"v","verse":"22","text":"Bul xañ néew-ji-doole ndax li muy néew-ji-doole."},{"style":"q1","verse":"22","text":"Ku tumurànke, bu ko soxore cib àtte,"},{"style":"q1","verse":"23","text":""},{"style":"v","verse":"23","text":"Aji Sax ji da koy taxawu,"},{"style":"q1","verse":"23","text":"ku ko xañ, mu xañ la bakkan."},{"style":"s2","verse":"","text":"[2]"},{"style":"q1","verse":"24","text":""},{"style":"v","verse":"24","text":"Bul xaritook ku gaawa mer,"},{"style":"q1","verse":"24","text":"bul ànd ak ku tàng bopp."},{"style":"q1","verse":"25","text":""},{"style":"v","verse":"25","text":"Lu ko moy nga mel ni moom,"},{"style":"q1","verse":"25","text":"te kon nga lonku."},{"style":"s2","verse":"","text":"[3]"},{"style":"q1","verse":"26","text":""},{"style":"v","verse":"26","text":"Bul bokk ci ñiy dige,"},{"style":"q1","verse":"26","text":"di gàddul nit bor."},{"style":"q1","verse":"27","text":""},{"style":"v","verse":"27","text":"Soo amul loo ko feyale,"},{"style":"q1","verse":"27","text":"ñu yékkatee la sab lal, nangu ko."},{"style":"s2","verse":"","text":"[4]"},{"style":"q1","verse":"28","text":""},{"style":"v","verse":"28","text":"Bul toxal màndargam cosaan ci làccu suuf"},{"style":"q1","verse":"28","text":"te say maam tegoon ko fa démb."},{"style":"s2","verse":"","text":"[5]"},{"style":"q1","verse":"29","text":""},{"style":"v","verse":"29","text":"Seetlul ku man liggéeyam,"},{"style":"q1","verse":"29","text":"buur lay liggéeyal,"},{"style":"q1","verse":"29","text":"du liggéeyal baadoolo."}]