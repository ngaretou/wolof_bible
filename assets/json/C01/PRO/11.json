[{"style":"q1","verse":"1","text":""},{"style":"v","verse":"1","text":"Aji Sax ji bañ na njublaŋ ci nattub diisaay,"},{"style":"q1","verse":"1","text":"ay nattukaay na mat, muy bànneexam."},{"style":"b","verse":"2","text":""},{"style":"q1","verse":"2","text":""},{"style":"v","verse":"2","text":"Ku réy-réylu rus;"},{"style":"q1","verse":"2","text":"woyofal ndax nga xelu."},{"style":"b","verse":"3","text":""},{"style":"q1","verse":"3","text":""},{"style":"v","verse":"3","text":"Kuy jubal, jiital mat."},{"style":"q1","verse":"3","text":"Njublaŋ ak wor, detteelu."},{"style":"b","verse":"4","text":""},{"style":"q1","verse":"4","text":""},{"style":"v","verse":"4","text":"Alal du jariñ bésu mbugal;"},{"style":"q1","verse":"4","text":"jub, mucc ci gàtt fan."},{"style":"b","verse":"5","text":""},{"style":"q1","verse":"5","text":""},{"style":"v","verse":"5","text":"Ku mat, dëgg xàllal la;"},{"style":"q1","verse":"5","text":"coxor daaneel boroom."},{"style":"b","verse":"6","text":""},{"style":"q1","verse":"6","text":""},{"style":"v","verse":"6","text":"Jubalal, sa jëfi njekk musal la;"},{"style":"q1","verse":"6","text":"ab workat day bëgge, ba far keppu."},{"style":"b","verse":"7","text":""},{"style":"q1","verse":"7","text":""},{"style":"v","verse":"7","text":"Ab soxor saay, yaakaaram seey,"},{"style":"q1","verse":"7","text":"rawatina yaakaar ju sës ci alal."},{"style":"b","verse":"8","text":""},{"style":"q1","verse":"8","text":""},{"style":"v","verse":"8","text":"Ku jub mucc ci njàqare,"},{"style":"q1","verse":"8","text":"ab soxor wuutu ko ca."},{"style":"b","verse":"9","text":""},{"style":"q1","verse":"9","text":""},{"style":"v","verse":"9","text":"Ay sos la yéefar di loree dëkkandoom,"},{"style":"q1","verse":"9","text":"waaye kiy jëfe njekk, xam-xam la cay mucce."},{"style":"b","verse":"10","text":""},{"style":"q1","verse":"10","text":""},{"style":"v","verse":"10","text":"Kiy jëfe njekk baaxle, waa dëkkam bànneexu;"},{"style":"q1","verse":"10","text":"ab saay-saay saay, mbégte dim riir."},{"style":"b","verse":"11","text":""},{"style":"q1","verse":"11","text":""},{"style":"v","verse":"11","text":"Barkeb kiy jëfe njekk teral nab dëkk,"},{"style":"q1","verse":"11","text":"kàddug ku soxor tas nab dëkk."},{"style":"b","verse":"12","text":""},{"style":"q1","verse":"12","text":""},{"style":"v","verse":"12","text":"Waxi xeebaate ñàkk bopp la,"},{"style":"q1","verse":"12","text":"ku am ag dégg day noppi."},{"style":"b","verse":"13","text":""},{"style":"q1","verse":"13","text":""},{"style":"v","verse":"13","text":"Kuy wër di sos dangay wuññi sutura,"},{"style":"q1","verse":"13","text":"ku jara wóolu dangay am bàmmeelu biir."},{"style":"b","verse":"14","text":""},{"style":"q1","verse":"14","text":""},{"style":"v","verse":"14","text":"Tegtal tumurànke, am réew suux;"},{"style":"q1","verse":"14","text":"digle bare, ndam dikk."},{"style":"b","verse":"15","text":""},{"style":"q1","verse":"15","text":""},{"style":"v","verse":"15","text":"Bul gàddul kenn bor, di loru;"},{"style":"q1","verse":"15","text":"bañ koo dige, daldi am jàmm."},{"style":"b","verse":"16","text":""},{"style":"q1","verse":"16","text":""},{"style":"v","verse":"16","text":"Jigéen, na yiw, ñu sagal ko;"},{"style":"q1","verse":"16","text":"góor gu néeg, alal doŋŋ."},{"style":"b","verse":"17","text":""},{"style":"q1","verse":"17","text":""},{"style":"v","verse":"17","text":"Ku baax, boppam;"},{"style":"q1","verse":"17","text":"ku bon, boppam."},{"style":"b","verse":"18","text":""},{"style":"q1","verse":"18","text":""},{"style":"v","verse":"18","text":"Coxor feyul boroom, day naxe;"},{"style":"q1","verse":"18","text":"deel def njekk, sag pey wóor."},{"style":"b","verse":"19","text":""},{"style":"q1","verse":"19","text":""},{"style":"v","verse":"19","text":"Saxoo njekk, dund;"},{"style":"q1","verse":"19","text":"sàlloo mbon, dee rekk."},{"style":"b","verse":"20","text":""},{"style":"q1","verse":"20","text":""},{"style":"v","verse":"20","text":"Aji Sax ji bañ na njublaŋ,"},{"style":"q1","verse":"20","text":"safoo ki mat."},{"style":"b","verse":"21","text":""},{"style":"q1","verse":"21","text":""},{"style":"v","verse":"21","text":"Ab soxor mbugalam du jaas, wóor na;"},{"style":"q1","verse":"21","text":"te ku jëfe njekk, saw askan mucc."},{"style":"b","verse":"22","text":""},{"style":"q1","verse":"22","text":""},{"style":"v","verse":"22","text":"Taaru jongama ju xel maa gàtt,"},{"style":"q1","verse":"22","text":"mooy jaaro wurus ci noppu mbaam-xuux."},{"style":"b","verse":"23","text":""},{"style":"q1","verse":"23","text":""},{"style":"v","verse":"23","text":"Kiy jëfe njekk, lu baax rekk lay sàkku;"},{"style":"q1","verse":"23","text":"soxor biy yaakaar, mujje mbugal."},{"style":"b","verse":"24","text":""},{"style":"q1","verse":"24","text":""},{"style":"v","verse":"24","text":"Nit a ngi tabe, di yokkule;"},{"style":"q1","verse":"24","text":"nit di nëŋ-nëŋi, gëna ñàkk."},{"style":"b","verse":"25","text":""},{"style":"q1","verse":"25","text":""},{"style":"v","verse":"25","text":"Ku yéwén, woomle;"},{"style":"q1","verse":"25","text":"kuy suuxat, suuxu."},{"style":"b","verse":"26","text":""},{"style":"q1","verse":"26","text":""},{"style":"v","verse":"26","text":"Nit a ngi móolu kuy denc pepp, ba mu ñàkkee,"},{"style":"q1","verse":"26","text":"di gërëm ka koy jaay."},{"style":"b","verse":"27","text":""},{"style":"q1","verse":"27","text":""},{"style":"v","verse":"27","text":"Wutal a wut lu baax, ñu nawloo la;"},{"style":"q1","verse":"27","text":"ku sàkku lu bon, yaa koy yenu."},{"style":"b","verse":"28","text":""},{"style":"q1","verse":"28","text":""},{"style":"v","verse":"28","text":"Ku yaakaar sa alal sab jéll a ngi ñëw,"},{"style":"q1","verse":"28","text":"ku jub day juble ni gàncax gu naat."},{"style":"b","verse":"29","text":""},{"style":"q1","verse":"29","text":""},{"style":"v","verse":"29","text":"Kuy fitnaal sa waa kër doo donn dara,"},{"style":"q1","verse":"29","text":"ku dof, boroom xel yilif la."},{"style":"b","verse":"30","text":""},{"style":"q1","verse":"30","text":""},{"style":"v","verse":"30","text":"Kuy jëfe njekk mbete garab guy taxa dund,"},{"style":"q1","verse":"30","text":"ku rafet xel am nit ñi."},{"style":"b","verse":"31","text":""},{"style":"q1","verse":"31","text":""},{"style":"v","verse":"31","text":"Kuy jëfe njekk, jot yoolam ci kaw suuf,"},{"style":"q1","verse":"31","text":"ku soxor keek bàkkaarkat bi it daw raw."}]