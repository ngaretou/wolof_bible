[{"style":"s1","verse":"","text":"Ragal Yàlla, jàmmi kër"},{"style":"d","verse":"1","text":""},{"style":"v","verse":"1","text":"Di \\w woy yu ñuy yéege|woy yi ñuy yéege\\w* ca tund ya, di ko màggale Yàlla."},{"style":"b","verse":"2","text":""},{"style":"q1","verse":"1","text":"Ndokkalee képp ku ragal Yàlla,"},{"style":"q1","verse":"1","text":"di jëfe ay yoonam."},{"style":"q1","verse":"2","text":""},{"style":"v","verse":"2","text":"Yaay lekk saw ñaq,"},{"style":"q1","verse":"2","text":"mbégteek ngëneel ñeel la."},{"style":"q1","verse":"3","text":""},{"style":"v","verse":"3","text":"Sa jabar ni garab gu meññ ci sa kër,"},{"style":"q1","verse":"3","text":"say doom wër a wër sa ndab ni njëmbat lu jebbi."},{"style":"q1","verse":"4","text":""},{"style":"v","verse":"4","text":"Ki ragal Aji Sax jaa ngoog,"},{"style":"q1","verse":"4","text":"nii rekk lay barkeele."},{"style":"b","verse":"5","text":""},{"style":"q1","verse":"5","text":""},{"style":"v","verse":"5","text":"Yal na la Yàlla barkeele fii ci \\w Siyoŋ|Siyoŋ:\\w*;"},{"style":"q1","verse":"5","text":"yal nanga teewe xéewalu Yerusalem sa giiru dund gépp,"},{"style":"q1","verse":"6","text":""},{"style":"v","verse":"6","text":"te nga gis say sët."},{"style":"q1","verse":"6","text":"Yal na jàmm dal Israayil."}]