[{"style":"s1","verse":"","text":"Siyoŋ, yaay ndeyu xeet yi"},{"style":"d","verse":"1","text":""},{"style":"v","verse":"1","text":"Ñeel askanu Kore wu góor, di woyu cant."},{"style":"b","verse":"2","text":""},{"style":"q1","verse":"1","text":"Dëkkub Aji Sax ji, kenu yaa nga ca tund yu sell ya."},{"style":"q1","verse":"2","text":""},{"style":"v","verse":"2","text":"Aji Sax jee sopp bunti \\w Siyoŋ|Siyoŋ:\\w* gii,"},{"style":"q1","verse":"2","text":"mu gënal ko fu askanu \\w Yanqóoba|Yanqóoba:\\w* dëkke."},{"style":"q1","verse":"3","text":""},{"style":"v","verse":"3","text":"Yaw, dëkkub Yàlla bi,"},{"style":"q1","verse":"3","text":"tuddees na say jaloore. \\qs \\+w Selaw|selaw:\\+w*.\\qs*"},{"style":"q1","verse":"4","text":""},{"style":"v","verse":"4","text":"Yàlla nee: «Ma limaale Misraak Babilon, ñi ma xam di dégg."},{"style":"q1","verse":"4","text":"Xoolal Filisti ak Tir, ak réewum \\w Kuus|Kuus:\\w*."},{"style":"q1","verse":"4","text":"Nit a ngii, juddoo fa.»"},{"style":"q1","verse":"5","text":""},{"style":"v","verse":"5","text":"Te teewul ñu cosaanale ko Siyoŋ,"},{"style":"q1","verse":"5","text":"ne kii ak kee fa bokk juddoo,"},{"style":"q1","verse":"5","text":"te Aji Kawe jee saxal Siyoŋ."},{"style":"q1","verse":"6","text":""},{"style":"v","verse":"6","text":"Aji Sax jeey lim xeet yi, limaale leen"},{"style":"q1","verse":"6","text":"ne: «Kii fi la juddoo.» \\qs Selaw.\\qs*"},{"style":"q1","verse":"7","text":""},{"style":"v","verse":"7","text":"Kuy fecc ak kuy woy ànd naan:"},{"style":"q1","verse":"7","text":"«Sunu cosaanoo cosaan fii la!»"}]