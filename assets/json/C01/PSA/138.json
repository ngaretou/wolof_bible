[{"style":"s1","verse":"","text":"Aji Sax ji waccu ma"},{"style":"d","verse":"1","text":""},{"style":"v","verse":"1","text":"Ñeel Daawuda."},{"style":"b","verse":"2","text":""},{"style":"q1","verse":"1","text":"Ma sante la sama léppi xol,"},{"style":"q1","verse":"1","text":"woy la, gàngooru Yàlla ga ca kaw seede."},{"style":"q1","verse":"2","text":""},{"style":"v","verse":"2","text":"Ma sujjóot jublook sa kër gu sell gi,"},{"style":"q1","verse":"2","text":"di wormaal saw tur,"},{"style":"q1","verse":"2","text":"ngir sa ngor ak sa worma."},{"style":"q1","verse":"2","text":"Màggal nga sa tur ak sa kàddu,"},{"style":"q1","verse":"2","text":"ba mu tiim lépp."},{"style":"q1","verse":"3","text":""},{"style":"v","verse":"3","text":"Bés ba ma wootee, yaa ma wuyu,"},{"style":"q1","verse":"3","text":"ñemeel ma, dooleel ma."},{"style":"b","verse":"4","text":""},{"style":"q1","verse":"4","text":""},{"style":"v","verse":"4","text":"Aji Sax ji, na la buuri àddina yépp màggal,"},{"style":"q1","verse":"4","text":"ñoo dégg kàddu yi nga wax."},{"style":"q1","verse":"5","text":""},{"style":"v","verse":"5","text":"Nañu woy say jaloore, naan:"},{"style":"q1","verse":"5","text":"«Aji Sax jeeka màgg ndam!»"},{"style":"q1","verse":"6","text":""},{"style":"v","verse":"6","text":"Aji Sax jee kawe!"},{"style":"q1","verse":"6","text":"Ku toroxlu, mu niir;"},{"style":"q1","verse":"6","text":"ku réy, mu ñooru."},{"style":"b","verse":"7","text":""},{"style":"q1","verse":"7","text":""},{"style":"v","verse":"7","text":"Ma wéye njàqare,"},{"style":"q1","verse":"7","text":"nga musal ma,"},{"style":"q1","verse":"7","text":"dogalee sa loxo merum noon,"},{"style":"q1","verse":"7","text":"walloo ma sa ndijoor."},{"style":"q1","verse":"8","text":""},{"style":"v","verse":"8","text":"Aji Sax jee may feyul."},{"style":"q1","verse":"8","text":"Éy Aji Sax ji, yaa saxoo ngor!"},{"style":"q1","verse":"8","text":"Bul wacc ñi nga binde sa loxo."}]