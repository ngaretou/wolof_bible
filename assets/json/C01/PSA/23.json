[{"style":"s1","verse":"","text":"Aji Sax jee may sàmm"},{"style":"d","verse":"1","text":""},{"style":"v","verse":"1","text":"Ñeel Daawuda, dib taalifu cant."},{"style":"b","verse":"2","text":""},{"style":"q1","verse":"1","text":"Aji Sax jee may sàmm,"},{"style":"q1","verse":"1","text":"du lenn lu ma ñàkk."},{"style":"q1","verse":"2","text":""},{"style":"v","verse":"2","text":"Parlu mu naat la may gooral,"},{"style":"q1","verse":"2","text":"wal mu dal, mu tette ma ca,"},{"style":"q1","verse":"3","text":""},{"style":"v","verse":"3","text":"leqali ma,"},{"style":"q1","verse":"3","text":"teg ma ci yooni njub"},{"style":"q1","verse":"3","text":"ngir teraangay turam."},{"style":"q1","verse":"4","text":""},{"style":"v","verse":"4","text":"Su may jaare xuru dee wu ne këruus it,"},{"style":"q1","verse":"4","text":"duma ragal loraange:"},{"style":"q1","verse":"4","text":"yaw laak man,"},{"style":"q1","verse":"4","text":"sa bantu sàmm ak sa nguul,"},{"style":"q1","verse":"4","text":"yooyoo may dalal."},{"style":"b","verse":"5","text":""},{"style":"q1","verse":"5","text":""},{"style":"v","verse":"5","text":"Yaa ma berndeel,"},{"style":"q1","verse":"5","text":"noon yi gis,"},{"style":"q1","verse":"5","text":"nga diwal ma saa bopp, terale ma,"},{"style":"q1","verse":"5","text":"saab kaas rembat."},{"style":"q1","verse":"6","text":""},{"style":"v","verse":"6","text":"Mbaax ak ngor kay la ma Aji Sax jiy dare sama giiru dund,"},{"style":"q1","verse":"6","text":"ma dëkke këram ba fàww."}]