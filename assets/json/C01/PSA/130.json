[{"style":"s1","verse":"","text":"Nu séentu njotug Yàlla"},{"style":"d","verse":"1","text":""},{"style":"v","verse":"1","text":"Di \\w woy yu ñuy yéege|woy yi ñuy yéege\\w* ca tund ya, di ko màggale Yàlla."},{"style":"b","verse":"2","text":""},{"style":"q1","verse":"1","text":"Aji Sax ji, ci ay xóote laa lay woowe."},{"style":"q1","verse":"2","text":""},{"style":"v","verse":"2","text":"Boroom bi, déglu ma,"},{"style":"q1","verse":"2","text":"teewlu ma, ma tinu la."},{"style":"b","verse":"3","text":""},{"style":"q1","verse":"3","text":""},{"style":"v","verse":"3","text":"Ki Sax, yaw, soo doon lim bàkkaar,"},{"style":"q1","verse":"3","text":"Boroom bi, ana kuy taxaw?"},{"style":"q1","verse":"4","text":""},{"style":"v","verse":"4","text":"Waaye yaay jéggale,"},{"style":"q1","verse":"4","text":"ñu ragal la."},{"style":"b","verse":"5","text":""},{"style":"q1","verse":"5","text":""},{"style":"v","verse":"5","text":"Damay xaar Aji Sax ji, di ko xaare xol,"},{"style":"q1","verse":"5","text":"di yaakaar kàddoom."},{"style":"q1","verse":"6","text":""},{"style":"v","verse":"6","text":"Wattukat bi yàkkamti njël,"},{"style":"q1","verse":"6","text":"wattukat bi yàkkamti njël, laa ne,"},{"style":"q1","verse":"6","text":"ni ma yàkkamtee Aji Sax jee ko raw."},{"style":"b","verse":"7","text":""},{"style":"q1","verse":"7","text":""},{"style":"v","verse":"7","text":"Éey Israayil, négandikul Aji Sax ji."},{"style":"q1","verse":"7","text":"Aji Sax jee gore,"},{"style":"q1","verse":"7","text":"te yaatug \\w njot|jot:\\w*."},{"style":"q1","verse":"8","text":""},{"style":"v","verse":"8","text":"Mooy jot Israayil ci ñaawtéefam yépp."}]