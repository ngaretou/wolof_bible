[{"style":"s1","verse":"","text":"Ku doyloo Aji Sax ji raw"},{"style":"d","verse":"1","text":""},{"style":"v","verse":"1","text":"Di \\w woy yu ñuy yéege|woy yi ñuy yéege\\w* ca tund ya, di ko màggale Yàlla."},{"style":"b","verse":"2","text":""},{"style":"q1","verse":"1","text":"Ku doyloo Aji Sax ji,"},{"style":"q1","verse":"1","text":"dangay mel ni tundu \\w Siyoŋ|Siyoŋ:\\w*, doo toxu;"},{"style":"q1","verse":"1","text":"dangay sax ba fàww."},{"style":"q1","verse":"2","text":""},{"style":"v","verse":"2","text":"Ni tund yi yéewe Yerusalem,"},{"style":"q1","verse":"2","text":"ni la Aji Sax ji yéewe ñoñam,"},{"style":"q1","verse":"2","text":"tey ak ëllëg."},{"style":"b","verse":"3","text":""},{"style":"q1","verse":"3","text":""},{"style":"v","verse":"3","text":"Nguur gu bon du saxe"},{"style":"q2","verse":"3","text":"kaw suuf su nit ñu jub muurloo."},{"style":"q1","verse":"3","text":"Lu ko moy ñu jub ñi sàkku lu bon,"},{"style":"q1","verse":"3","text":"di ko jëfe."},{"style":"b","verse":"4","text":""},{"style":"q1","verse":"4","text":""},{"style":"v","verse":"4","text":"Éy Aji Sax ji, baaxeel ku baax,"},{"style":"q1","verse":"4","text":"ak kuy mébét njub."},{"style":"q1","verse":"5","text":""},{"style":"v","verse":"5","text":"Waaye kuy topp yoonu ndëngte,"},{"style":"q1","verse":"5","text":"Aji Sax jee koy sànk,"},{"style":"q1","verse":"5","text":"boole kook kuy def lu bon."},{"style":"q1","verse":"5","text":"Yal na jàmm dal ci Israayil."}]