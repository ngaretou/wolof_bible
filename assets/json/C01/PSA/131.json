[{"style":"s1","verse":"","text":"Damaa woyof, gëm Yàlla"},{"style":"d","verse":"1","text":""},{"style":"v","verse":"1","text":"Di \\w woy yu ñuy yéege|woy yi ñuy yéege\\w* ca tund ya, di ko màggale Yàlla, ñeel Daawuda."},{"style":"b","verse":"2","text":""},{"style":"q1","verse":"1","text":"Éy Aji Sax ji, man de, réy-réyluwuma,"},{"style":"q1","verse":"1","text":"daŋŋiiraluma,"},{"style":"q1","verse":"1","text":"xintewoowuma lu réy it,"},{"style":"q1","verse":"1","text":"mbaa lu ma ëlëm."},{"style":"q1","verse":"2","text":""},{"style":"v","verse":"2","text":"Xanaa ne tekk, ne cell,"},{"style":"q1","verse":"2","text":"ni perantal ak ndeyam;"},{"style":"q1","verse":"2","text":"sama xel dal ni perantal."},{"style":"q1","verse":"3","text":""},{"style":"v","verse":"3","text":"Éey Israayil, yaakaaral Aji Sax ji"},{"style":"q1","verse":"3","text":"tey ak ëllëg."}]