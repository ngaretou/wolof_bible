[{"style":"s1","verse":"","text":"Dund yàggul"},{"style":"d","verse":"1","text":""},{"style":"v","verse":"1","text":"Mu jëm ci Yedutun, njiital woykat yi, dib taalifu cant, ñeel Daawuda."},{"style":"b","verse":"2","text":""},{"style":"q1","verse":"2","text":""},{"style":"v","verse":"2","text":"Dama noon: «Damay moyu ba duma moye làmmiñ.»"},{"style":"q1","verse":"2","text":"Li feek ku bon di teew,"},{"style":"q1","verse":"2","text":"may ŋalaab sama gémmiñ."},{"style":"q1","verse":"3","text":""},{"style":"v","verse":"3","text":"Dama noon cell, ne patt,"},{"style":"q1","verse":"3","text":"noppi, ba mu ëpp;"},{"style":"q1","verse":"3","text":"sama njàqare yokku,"},{"style":"q1","verse":"4","text":""},{"style":"v","verse":"4","text":"sama xol diis,"},{"style":"q1","verse":"4","text":"xel di xelaat, xol diis gann;"},{"style":"q1","verse":"4","text":"ma mujj àddu,"},{"style":"q1","verse":"5","text":""},{"style":"v","verse":"5","text":"ne: «Éy Aji Sax ji, xamal ma sama muj"},{"style":"q1","verse":"5","text":"ak sama àppi fan,"},{"style":"q1","verse":"5","text":"ma xam ni sama dund gàtte."},{"style":"q1","verse":"6","text":""},{"style":"v","verse":"6","text":"Yaatuwaayu loxo nga ma àppal ciy fan,"},{"style":"q1","verse":"6","text":"sama giiru dund du dara fi yaw."},{"style":"q1","verse":"6","text":"Képp ku taxaw di cóolóolu neen. \\qs \\+w Selaw|selaw:\\+w*.\\qs*"},{"style":"q1","verse":"7","text":""},{"style":"v","verse":"7","text":"Nit du lu moy takkndeer buy dem,"},{"style":"q1","verse":"7","text":"cóolóolu neen lay kër-këri."},{"style":"q1","verse":"7","text":"Nit a ngi dajale, xamul kuy for."},{"style":"b","verse":"8","text":""},{"style":"q1","verse":"8","text":""},{"style":"v","verse":"8","text":"«Éy Boroom bi, lu may xaarati?"},{"style":"q1","verse":"8","text":"Sama yaakaar yaw a."},{"style":"q1","verse":"9","text":""},{"style":"v","verse":"9","text":"Musal ma ci sama mbugali tooñoo tooñ,"},{"style":"q1","verse":"9","text":"bu ma bàyyi, dof di ma reetaan!"},{"style":"q1","verse":"10","text":""},{"style":"v","verse":"10","text":"Noppi naa, dootuma wax,"},{"style":"q1","verse":"10","text":"yaw yaa dogal lii."},{"style":"q1","verse":"11","text":""},{"style":"v","verse":"11","text":"Waaye ngalla teggil sab yar,"},{"style":"q1","verse":"11","text":"sa diisaayu loxoo ngi may jekkali."},{"style":"q1","verse":"12","text":""},{"style":"v","verse":"12","text":"Yaay mbugal ku bàkkaar, yar ko,"},{"style":"q1","verse":"12","text":"ronq la mu gëna fonk, ni max."},{"style":"q1","verse":"12","text":"Nitoo nit, cóolóolu neen. \\qs Selaw.\\qs*"},{"style":"q1","verse":"13","text":""},{"style":"v","verse":"13","text":"Éy Aji Sax ji, déglul, ma ñaan la,"},{"style":"q1","verse":"13","text":"teewlul, ma woo la wall;"},{"style":"q1","verse":"13","text":"bul tanqamlu sama yuux,"},{"style":"q1","verse":"13","text":"doxandéem doŋŋ laa fi yaw,"},{"style":"q1","verse":"13","text":"di gan ni maam yépp."},{"style":"q1","verse":"14","text":""},{"style":"v","verse":"14","text":"Ngalla xiddi ma, ma muuñ,"},{"style":"q1","verse":"14","text":"bala maa dëddu, réer.»"}]