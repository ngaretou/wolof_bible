[{"style":"s1","verse":"","text":"Buur Yàllaay walloo"},{"style":"q1","verse":"1","text":""},{"style":"v","verse":"1","text":"Màggalleen Ki Sax!"},{"style":"q1","verse":"1","text":"Yeen ñiy jaamu Aji Sax ji, màggalleen ko,"},{"style":"q1","verse":"1","text":"màggalleen turu Aji Sax ji!"},{"style":"q1","verse":"2","text":""},{"style":"v","verse":"2","text":"Yal nañu teral turu Aji Sax ji"},{"style":"q1","verse":"2","text":"tey ak ëllëg!"},{"style":"q1","verse":"3","text":""},{"style":"v","verse":"3","text":"Li dale penku ba sowu,"},{"style":"q1","verse":"3","text":"màggalleen Aji Sax ji."},{"style":"b","verse":"4","text":""},{"style":"q1","verse":"4","text":""},{"style":"v","verse":"4","text":"Aji Sax jee kawe, tiim xeetoo xeet,"},{"style":"q1","verse":"4","text":"darajaam sut asamaan!"},{"style":"q1","verse":"5","text":""},{"style":"v","verse":"5","text":"Ana ku mel ni sunu Yàlla Aji Sax ji,"},{"style":"q1","verse":"5","text":"ki kaweel ab jalam, toog,"},{"style":"q1","verse":"6","text":""},{"style":"v","verse":"6","text":"di jéer asamaan ak suuf?"},{"style":"b","verse":"7","text":""},{"style":"q1","verse":"7","text":""},{"style":"v","verse":"7","text":"Mooy yékkatee ku néewle fa suuf,"},{"style":"q1","verse":"7","text":"di seppee ku sonn cib sën,"},{"style":"q1","verse":"8","text":""},{"style":"v","verse":"8","text":"bokkal ko jataayu kilifa"},{"style":"q2","verse":"8","text":"ya jiite xeetam."},{"style":"q1","verse":"9","text":""},{"style":"v","verse":"9","text":"Mooy dëël jigéen ju tële woona jur,"},{"style":"q1","verse":"9","text":"may ko mbégtem njureel."},{"style":"q1","verse":"9","text":"Màggalleen Ki Sax!"}]