[{"style":"s1","verse":"","text":"Yàllaa am kóllëre"},{"style":"q1","verse":"1","text":""},{"style":"v","verse":"1","text":"Nangeen sante Aji Sax ji mbaaxam."},{"style":"qr","verse":"1","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"2","text":""},{"style":"v","verse":"2","text":"Santleen Yàllay yàlla yi."},{"style":"qr","verse":"2","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"3","text":""},{"style":"v","verse":"3","text":"Santleen Sangu sang yi."},{"style":"qr","verse":"3","text":"Kee saxoo ngoram!"},{"style":"b","verse":"4","text":""},{"style":"q1","verse":"4","text":""},{"style":"v","verse":"4","text":"Moo wéetoo jaloore yu mag yi."},{"style":"qr","verse":"4","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"5","text":""},{"style":"v","verse":"5","text":"Moo sàkk asamaan ci manooreem."},{"style":"qr","verse":"5","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"6","text":""},{"style":"v","verse":"6","text":"Moo lal suuf ca kaw ndox ma."},{"style":"qr","verse":"6","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"7","text":""},{"style":"v","verse":"7","text":"Moo sàkk leer yu mag yi:"},{"style":"qr","verse":"7","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"8","text":""},{"style":"v","verse":"8","text":"jant bi yilif bëccëg,"},{"style":"qr","verse":"8","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"9","text":""},{"style":"v","verse":"9","text":"weer ak biddiiw, guddi."},{"style":"qr","verse":"9","text":"Kee saxoo ngoram!"},{"style":"b","verse":"10","text":""},{"style":"q1","verse":"10","text":""},{"style":"v","verse":"10","text":"Moo faat taawi Misra yu góor ya,"},{"style":"qr","verse":"10","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"11","text":""},{"style":"v","verse":"11","text":"seppee \\w bànni Israayil|bànni Israayil:\\w* ca ñoom,"},{"style":"qr","verse":"11","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"12","text":""},{"style":"v","verse":"12","text":"ci dooley loxoom ak kàttanu përëgam."},{"style":"qr","verse":"12","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"13","text":""},{"style":"v","verse":"13","text":"Moo xar géeju Barax ya ñaar,"},{"style":"qr","verse":"13","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"14","text":""},{"style":"v","verse":"14","text":"jàllale bànni Israayil ca digg ba."},{"style":"qr","verse":"14","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"15","text":""},{"style":"v","verse":"15","text":"Moo xalab Firawnaak mbooloom ca géeju Barax ya."},{"style":"qr","verse":"15","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"16","text":""},{"style":"v","verse":"16","text":"Moo jiite ñoñam ca màndiŋ ma."},{"style":"qr","verse":"16","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"17","text":""},{"style":"v","verse":"17","text":"Moo duma buur yu mag ya,"},{"style":"qr","verse":"17","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"18","text":""},{"style":"v","verse":"18","text":"bóom buur yu màgg ya,"},{"style":"qr","verse":"18","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"19","text":""},{"style":"v","verse":"19","text":"reyaale Sixon buurub Amoreen ña,"},{"style":"qr","verse":"19","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"20","text":""},{"style":"v","verse":"20","text":"reyati Og buuru Basan."},{"style":"qr","verse":"20","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"21","text":""},{"style":"v","verse":"21","text":"Moo nangu seen réew, joxe,"},{"style":"qr","verse":"21","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"22","text":""},{"style":"v","verse":"22","text":"sédde Israayil ma dib jaamam."},{"style":"qr","verse":"22","text":"Kee saxoo ngoram!"},{"style":"b","verse":"23","text":""},{"style":"q1","verse":"23","text":""},{"style":"v","verse":"23","text":"Ci biir nootaange la nu geesoo,"},{"style":"qr","verse":"23","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"24","text":""},{"style":"v","verse":"24","text":"ne nu siféet ci loxoy noon ya."},{"style":"qr","verse":"24","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"25","text":""},{"style":"v","verse":"25","text":"Mooy leel bépp boroom bakkan."},{"style":"qr","verse":"25","text":"Kee saxoo ngoram!"},{"style":"q1","verse":"26","text":""},{"style":"v","verse":"26","text":"Santleen Yàlla mi ci asamaan!"},{"style":"qr","verse":"26","text":"Kee saxoo ngoram!"}]