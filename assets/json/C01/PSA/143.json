[{"style":"s1","verse":"","text":"Aji Sax jeey sama yaakaar"},{"style":"d","verse":"1","text":""},{"style":"v","verse":"1","text":"Dib taalifu cant, ñeel Daawuda."},{"style":"b","verse":"2","text":""},{"style":"q1","verse":"1","text":"Éy Aji Sax ji, déglul, ma ñaan la;"},{"style":"q1","verse":"1","text":"teewlul, ma tinu la;"},{"style":"q1","verse":"1","text":"nangul ma ci sa wormaak sa àtteb dëgg."},{"style":"q1","verse":"2","text":""},{"style":"v","verse":"2","text":"Sang bi, bul layook man;"},{"style":"q1","verse":"2","text":"kenn jubul fi sa kanam, du kuy dund."},{"style":"q1","verse":"3","text":""},{"style":"v","verse":"3","text":"Noon a ma sambal,"},{"style":"q1","verse":"3","text":"daane ma, joggati,"},{"style":"q1","verse":"3","text":"dëël ma ci lëndëm"},{"style":"q1","verse":"3","text":"ni ku dee bu yàgg."},{"style":"q1","verse":"4","text":""},{"style":"v","verse":"4","text":"Sama doole jeex tàkk,"},{"style":"q1","verse":"4","text":"sama xol jeex, ma ne yàcc."},{"style":"q1","verse":"5","text":""},{"style":"v","verse":"5","text":"May fàttaliku bu njëkkoon,"},{"style":"q1","verse":"5","text":"di xalaat sa jaloore yépp,"},{"style":"q1","verse":"5","text":"seetaat li nga def."},{"style":"q1","verse":"6","text":""},{"style":"v","verse":"6","text":"Ma tàllal lay loxo,"},{"style":"q1","verse":"6","text":"soxla la, ni suuf su mar di soxlaa ndox. \\qs \\+w Selaw|selaw:\\+w*.\\qs*"},{"style":"b","verse":"7","text":""},{"style":"q1","verse":"7","text":""},{"style":"v","verse":"7","text":"Aji Sax ji, gaawal wuyu ma;"},{"style":"q1","verse":"7","text":"sama xol a jeex, ma ne yàcc,"},{"style":"q1","verse":"7","text":"bu ma xañ sa yiw,"},{"style":"q1","verse":"7","text":"ma yem ak kuy tàbbiji biir pax."},{"style":"q1","verse":"8","text":""},{"style":"v","verse":"8","text":"Xëye ma sa ngor,"},{"style":"q1","verse":"8","text":"yaw laa wóolu;"},{"style":"q1","verse":"8","text":"xamal ma fu may doxe,"},{"style":"q1","verse":"8","text":"yaw laa wékk sama bakkan."},{"style":"q1","verse":"9","text":""},{"style":"v","verse":"9","text":"Aji Sax ji, musal ma ci noon yi,"},{"style":"q1","verse":"9","text":"yaw laa làqoo."},{"style":"q1","verse":"10","text":""},{"style":"v","verse":"10","text":"Jàngal ma, ma jëfe sa coobare;"},{"style":"q1","verse":"10","text":"yaa di sama Yàlla."},{"style":"q1","verse":"10","text":"Yal na ma sam xel jiitee mbaax"},{"style":"q1","verse":"10","text":"ci yoon wu tàlli."},{"style":"q1","verse":"11","text":""},{"style":"v","verse":"11","text":"Aji Sax ji, musal ma ngir sa tur,"},{"style":"q1","verse":"11","text":"jëfeel sa àtte, teggil ma njàqarey bakkan."},{"style":"q1","verse":"12","text":""},{"style":"v","verse":"12","text":"Sànkal ma noon yi ci sa ngor,"},{"style":"q1","verse":"12","text":"bóomal ma bépp mbañ."},{"style":"q1","verse":"12","text":"Man de, maay sab jaam!"}]