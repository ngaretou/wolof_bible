[{"style":"s","verse":"","text":"Prière dans la détresse"},{"style":"d","verse":"1","text":""},{"style":"v","verse":"1","text":"Cantique de David, lorsqu'il se trouvait dans la grotte. Prière."},{"style":"b","verse":"2","text":""},{"style":"q","verse":"2","text":""},{"style":"v","verse":"2","text":"A pleine voix je crie à l'Eternel,"},{"style":"q","verse":"2","text":"à pleine voix j'implore l'Eternel."},{"style":"q","verse":"3","text":""},{"style":"v","verse":"3","text":"Je lui expose ma plainte,"},{"style":"q","verse":"3","text":"je lui raconte ma détresse."},{"style":"b","verse":"4","text":""},{"style":"q","verse":"4","text":""},{"style":"v","verse":"4","text":"Quand mon esprit est abattu en moi,"},{"style":"q","verse":"4","text":"toi, tu connais mon sentier."},{"style":"q","verse":"4","text":"Sur la route où je marche,"},{"style":"q","verse":"4","text":"on m'a tendu un piège."},{"style":"q","verse":"5","text":""},{"style":"v","verse":"5","text":"Regarde à droite et constate-le:"},{"style":"q","verse":"5","text":"personne ne me reconnaît,"},{"style":"q","verse":"5","text":"je ne sais plus où trouver refuge,"},{"style":"q","verse":"5","text":"personne ne s'inquiète pour ma vie."},{"style":"b","verse":"6","text":""},{"style":"q","verse":"6","text":""},{"style":"v","verse":"6","text":"Eternel, c'est à toi que je crie."},{"style":"q","verse":"6","text":"Je dis: «Tu es mon abri,"},{"style":"q","verse":"6","text":"ma part au pays des vivants.»"},{"style":"q","verse":"7","text":""},{"style":"v","verse":"7","text":"Sois attentif à mes cris,"},{"style":"q","verse":"7","text":"car je suis bien faible!"},{"style":"q","verse":"7","text":"Délivre-moi de ceux qui me poursuivent,"},{"style":"q","verse":"7","text":"car ils sont plus forts que moi!"},{"style":"q","verse":"8","text":""},{"style":"v","verse":"8","text":"Fais-moi sortir de ma prison"},{"style":"q","verse":"8","text":"afin que je célèbre ton nom!"},{"style":"q","verse":"8","text":"Les justes viendront m'entourer"},{"style":"q","verse":"8","text":"quand tu m'auras fait du bien."}]