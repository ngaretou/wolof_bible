[{"style":"s","verse":"","text":"Dieu protège et délivre les siens"},{"style":"d","verse":"1","text":""},{"style":"v","verse":"1","text":"Chant des montées, de David."},{"style":"b","verse":"2","text":""},{"style":"q","verse":"1","text":"Si l'Eternel n'avait pas été pour nous"},{"style":"q","verse":"1","text":"– qu'Israël le dise –"},{"style":"q","verse":"2","text":""},{"style":"v","verse":"2","text":"si l'Eternel n'avait pas été pour nous"},{"style":"q","verse":"2","text":"lorsque des hommes sont venus nous attaquer,"},{"style":"q","verse":"3","text":""},{"style":"v","verse":"3","text":"ils nous auraient engloutis vivants"},{"style":"q","verse":"3","text":"quand leur colère s'est enflammée contre nous."},{"style":"b","verse":"4","text":""},{"style":"q","verse":"4","text":""},{"style":"v","verse":"4","text":"Oui, l'eau nous aurait emportés,"},{"style":"q","verse":"4","text":"les torrents nous auraient submergés."},{"style":"q","verse":"5","text":""},{"style":"v","verse":"5","text":"Oui, ils nous auraient submergés,"},{"style":"q","verse":"5","text":"les flots impétueux."},{"style":"b","verse":"6","text":""},{"style":"q","verse":"6","text":""},{"style":"v","verse":"6","text":"Béni soit l'Eternel"},{"style":"q","verse":"6","text":"qui ne nous a pas livrés en pâture à leurs dents!"},{"style":"q","verse":"7","text":""},{"style":"v","verse":"7","text":"Nous nous sommes échappés comme l'oiseau du piège des oiseleurs:"},{"style":"q","verse":"7","text":"le filet s'est rompu, et nous nous sommes échappés."},{"style":"b","verse":"8","text":""},{"style":"q","verse":"8","text":""},{"style":"v","verse":"8","text":"Notre secours est dans le nom de l'Eternel,"},{"style":"q","verse":"8","text":"qui a fait le ciel et la terre."}]