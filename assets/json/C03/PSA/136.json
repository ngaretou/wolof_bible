[{"style":"s","verse":"","text":"La bonté éternelle de Dieu"},{"style":"b","verse":"1","text":""},{"style":"q","verse":"1","text":""},{"style":"v","verse":"1","text":"Louez l'Eternel, car il est bon!"},{"style":"b","verse":"2","text":""},{"style":"q","verse":"1","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"2","text":""},{"style":"q","verse":"2","text":""},{"style":"v","verse":"2","text":"Louez le Dieu des dieux!"},{"style":"b","verse":"3","text":""},{"style":"q","verse":"2","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"3","text":""},{"style":"q","verse":"3","text":""},{"style":"v","verse":"3","text":"Louez le Seigneur des seigneurs!"},{"style":"b","verse":"4","text":""},{"style":"q","verse":"3","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"4","text":""},{"style":"q","verse":"4","text":""},{"style":"v","verse":"4","text":"Lui seul fait de grands miracles."},{"style":"b","verse":"5","text":""},{"style":"q","verse":"4","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"5","text":""},{"style":"q","verse":"5","text":""},{"style":"v","verse":"5","text":"Il a fait le ciel avec intelligence."},{"style":"b","verse":"6","text":""},{"style":"q","verse":"5","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"6","text":""},{"style":"q","verse":"6","text":""},{"style":"v","verse":"6","text":"Il a disposé la terre sur l'eau."},{"style":"b","verse":"7","text":""},{"style":"q","verse":"6","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"7","text":""},{"style":"q","verse":"7","text":""},{"style":"v","verse":"7","text":"Il a fait les grands luminaires:"},{"style":"b","verse":"8","text":""},{"style":"q","verse":"7","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"8","text":""},{"style":"q","verse":"8","text":""},{"style":"v","verse":"8","text":"le soleil pour présider au jour,"},{"style":"b","verse":"9","text":""},{"style":"q","verse":"8","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"9","text":""},{"style":"q","verse":"9","text":""},{"style":"v","verse":"9","text":"la lune et les étoiles pour présider à la nuit."},{"style":"b","verse":"10","text":""},{"style":"q","verse":"9","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"10","text":""},{"style":"q","verse":"10","text":""},{"style":"v","verse":"10","text":"Il a frappé les Egyptiens à travers leurs premiers-nés,"},{"style":"b","verse":"11","text":""},{"style":"q","verse":"10","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"11","text":""},{"style":"q","verse":"11","text":""},{"style":"v","verse":"11","text":"il a fait sortir Israël du milieu d'eux,"},{"style":"b","verse":"12","text":""},{"style":"q","verse":"11","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"12","text":""},{"style":"q","verse":"12","text":""},{"style":"v","verse":"12","text":"avec puissance et force."},{"style":"b","verse":"13","text":""},{"style":"q","verse":"12","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"13","text":""},{"style":"q","verse":"13","text":""},{"style":"v","verse":"13","text":"Il a coupé en deux la mer des Roseaux,"},{"style":"b","verse":"14","text":""},{"style":"q","verse":"13","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"14","text":""},{"style":"q","verse":"14","text":""},{"style":"v","verse":"14","text":"il a fait passer Israël en plein milieu,"},{"style":"b","verse":"15","text":""},{"style":"q","verse":"14","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"15","text":""},{"style":"q","verse":"15","text":""},{"style":"v","verse":"15","text":"puis il a précipité le pharaon et son armée dans la mer des Roseaux."},{"style":"b","verse":"16","text":""},{"style":"q","verse":"15","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"16","text":""},{"style":"q","verse":"16","text":""},{"style":"v","verse":"16","text":"Il a conduit son peuple dans le désert,"},{"style":"b","verse":"17","text":""},{"style":"q","verse":"16","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"17","text":""},{"style":"q","verse":"17","text":""},{"style":"v","verse":"17","text":"il a frappé de grands rois,"},{"style":"b","verse":"18","text":""},{"style":"q","verse":"17","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"18","text":""},{"style":"q","verse":"18","text":""},{"style":"v","verse":"18","text":"il a tué des rois puissants:"},{"style":"b","verse":"19","text":""},{"style":"q","verse":"18","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"19","text":""},{"style":"q","verse":"19","text":""},{"style":"v","verse":"19","text":"Sihon, le roi des Amoréens,"},{"style":"b","verse":"20","text":""},{"style":"q","verse":"19","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"20","text":""},{"style":"q","verse":"20","text":""},{"style":"v","verse":"20","text":"et Og, le roi du Basan."},{"style":"b","verse":"21","text":""},{"style":"q","verse":"20","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"21","text":""},{"style":"q","verse":"21","text":""},{"style":"v","verse":"21","text":"Il a donné leur pays en héritage,"},{"style":"b","verse":"22","text":""},{"style":"q","verse":"21","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"22","text":""},{"style":"q","verse":"22","text":""},{"style":"v","verse":"22","text":"en héritage à Israël, son serviteur."},{"style":"b","verse":"23","text":""},{"style":"q","verse":"22","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"23","text":""},{"style":"q","verse":"23","text":""},{"style":"v","verse":"23","text":"Il s'est souvenu de nous quand nous étions humiliés,"},{"style":"b","verse":"24","text":""},{"style":"q","verse":"23","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"24","text":""},{"style":"q","verse":"24","text":""},{"style":"v","verse":"24","text":"il nous a délivrés de nos adversaires."},{"style":"b","verse":"25","text":""},{"style":"q","verse":"24","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"25","text":""},{"style":"q","verse":"25","text":""},{"style":"v","verse":"25","text":"Il donne la nourriture à tout être vivant."},{"style":"b","verse":"26","text":""},{"style":"q","verse":"25","text":"– Oui, sa bonté dure éternellement. –"},{"style":"b","verse":"26","text":""},{"style":"q","verse":"26","text":""},{"style":"v","verse":"26","text":"Louez le Dieu du ciel!"},{"style":"b","verse":"26","text":""},{"style":"q","verse":"26","text":"– Oui, sa bonté dure éternellement. –"}]