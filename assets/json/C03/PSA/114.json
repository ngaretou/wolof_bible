[{"style":"s","verse":"","text":"Rappel des délivrances passées"},{"style":"q","verse":"1","text":""},{"style":"v","verse":"1","text":"Quand Israël est sorti d'Egypte,"},{"style":"q","verse":"1","text":"quand la famille de Jacob s'est éloignée d'un peuple étranger,"},{"style":"q","verse":"2","text":""},{"style":"v","verse":"2","text":"Juda est devenu le sanctuaire de Dieu,"},{"style":"q","verse":"2","text":"Israël a été son domaine."},{"style":"q","verse":"3","text":""},{"style":"v","verse":"3","text":"La mer l'a vu et s'est enfuie,"},{"style":"q","verse":"3","text":"le Jourdain est retourné en arrière;"},{"style":"q","verse":"4","text":""},{"style":"v","verse":"4","text":"les montagnes ont sauté comme des béliers,"},{"style":"q","verse":"4","text":"les collines comme des agneaux."},{"style":"b","verse":"5","text":""},{"style":"q","verse":"5","text":""},{"style":"v","verse":"5","text":"Qu'as-tu, mer, pour t'enfuir,"},{"style":"q","verse":"5","text":"et toi, Jourdain, pour retourner en arrière?"},{"style":"q","verse":"6","text":""},{"style":"v","verse":"6","text":"Qu'avez-vous, montagnes, pour sauter comme des béliers,"},{"style":"q","verse":"6","text":"et vous, collines, comme des agneaux?"},{"style":"q","verse":"7","text":""},{"style":"v","verse":"7","text":"Tremble donc, terre, devant le Seigneur,"},{"style":"q","verse":"7","text":"devant le Dieu de Jacob!"},{"style":"q","verse":"8","text":""},{"style":"v","verse":"8","text":"Il change le rocher en étang,"},{"style":"q","verse":"8","text":"le roc en source d'eau."}]