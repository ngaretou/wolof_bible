[{"style":"s","verse":"","text":"Appel à une louange universelle"},{"style":"b","verse":"1","text":""},{"style":"q","verse":"1","text":""},{"style":"v","verse":"1","text":"Louez l'Eternel!"},{"style":"q","verse":"1","text":"Louez Dieu dans son sanctuaire!"},{"style":"q","verse":"1","text":"Louez-le dans l'étendue céleste où éclate sa puissance!"},{"style":"q","verse":"2","text":""},{"style":"v","verse":"2","text":"Louez-le pour son extraordinaire façon d'agir!"},{"style":"q","verse":"2","text":"Louez-le pour l'immensité de sa grandeur!"},{"style":"b","verse":"3","text":""},{"style":"q","verse":"3","text":""},{"style":"v","verse":"3","text":"Louez-le au son de la trompette!"},{"style":"q","verse":"3","text":"Louez-le avec le luth et la harpe!"},{"style":"q","verse":"4","text":""},{"style":"v","verse":"4","text":"Louez-le avec le tambourin et avec des danses!"},{"style":"q","verse":"4","text":"Louez-le avec les instruments à cordes et la flûte!"},{"style":"q","verse":"5","text":""},{"style":"v","verse":"5","text":"Louez-le avec les cymbales sonores!"},{"style":"q","verse":"5","text":"Louez-le avec les cymbales retentissantes!"},{"style":"b","verse":"6","text":""},{"style":"q","verse":"6","text":""},{"style":"v","verse":"6","text":"Que tout ce qui respire loue l'Eternel!"},{"style":"q","verse":"6","text":"Louez l'Eternel!"}]