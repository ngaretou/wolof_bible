[{"style":"s","verse":"","text":"Secours et protection de Dieu"},{"style":"d","verse":"1","text":""},{"style":"v","verse":"1","text":"Chant des montées."},{"style":"b","verse":"2","text":""},{"style":"q","verse":"1","text":"Je lève mes yeux vers les montagnes:"},{"style":"q","verse":"1","text":"d'où me viendra le secours?"},{"style":"q","verse":"2","text":""},{"style":"v","verse":"2","text":"Le secours me vient de l'Eternel,"},{"style":"q","verse":"2","text":"qui a fait le ciel et la terre."},{"style":"b","verse":"3","text":""},{"style":"q","verse":"3","text":""},{"style":"v","verse":"3","text":"Qu'il ne permette pas à ton pied de trébucher, qu'il ne somnole pas,"},{"style":"q","verse":"3","text":"celui qui te garde!"},{"style":"b","verse":"4","text":""},{"style":"q","verse":"4","text":""},{"style":"v","verse":"4","text":"Non, il ne somnole pas, il ne dort pas,"},{"style":"q","verse":"4","text":"celui qui garde Israël."},{"style":"q","verse":"5","text":""},{"style":"v","verse":"5","text":"L'Eternel est celui qui te garde,"},{"style":"q","verse":"5","text":"l'Eternel est ton ombre protectrice, il se tient à ta droite."},{"style":"q","verse":"6","text":""},{"style":"v","verse":"6","text":"Pendant le jour le soleil ne te fera pas de mal,"},{"style":"q","verse":"6","text":"ni la lune pendant la nuit."},{"style":"q","verse":"7","text":""},{"style":"v","verse":"7","text":"L'Eternel te gardera de tout mal,"},{"style":"q","verse":"7","text":"il gardera ta vie."},{"style":"q","verse":"8","text":""},{"style":"v","verse":"8","text":"L'Eternel gardera ton départ et ton arrivée"},{"style":"q","verse":"8","text":"dès maintenant et pour toujours."}]