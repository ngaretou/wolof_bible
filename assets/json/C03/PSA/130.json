[{"style":"s","verse":"","text":"Attente de l'intervention de Dieu"},{"style":"d","verse":"1","text":""},{"style":"v","verse":"1","text":"Chant des montées."},{"style":"b","verse":"2","text":""},{"style":"q","verse":"1","text":"Du fond du gouffre, je fais appel à toi, Eternel!"},{"style":"q","verse":"2","text":""},{"style":"v","verse":"2","text":"Seigneur, écoute-moi!"},{"style":"q","verse":"2","text":"Que tes oreilles soient attentives"},{"style":"q","verse":"2","text":"à mes supplications!"},{"style":"b","verse":"3","text":""},{"style":"b","verse":"3","text":""},{"style":"q","verse":"3","text":""},{"style":"v","verse":"3","text":"Si tu tenais compte de nos fautes, Eternel, Seigneur, qui pourrait subsister?"},{"style":"q","verse":"4","text":""},{"style":"v","verse":"4","text":"Mais le pardon se trouve auprès de toi"},{"style":"q","verse":"4","text":"afin qu'on te craigne."},{"style":"b","verse":"5","text":""},{"style":"q","verse":"5","text":""},{"style":"v","verse":"5","text":"J'espère en l'Eternel de toute mon âme"},{"style":"q","verse":"5","text":"et je m'attends à sa promesse."},{"style":"q","verse":"6","text":""},{"style":"v","verse":"6","text":"Je compte sur le Seigneur"},{"style":"q","verse":"6","text":"plus que les gardes n'attendent le matin,"},{"style":"q","verse":"6","text":"oui, plus que les gardes n'attendent le matin."},{"style":"b","verse":"7","text":""},{"style":"q","verse":"7","text":""},{"style":"v","verse":"7","text":"Israël, mets ton espoir en l'Eternel,"},{"style":"q","verse":"7","text":"car c'est auprès de l'Eternel que se trouve la bonté,"},{"style":"q","verse":"7","text":"c'est auprès de lui que se trouve une généreuse libération."},{"style":"q","verse":"8","text":""},{"style":"v","verse":"8","text":"C'est lui qui rachètera Israël"},{"style":"q","verse":"8","text":"de toutes ses fautes."}]