[{"style":"s","verse":"","text":"La souffrance de l'exilé"},{"style":"d","verse":"1","text":""},{"style":"v","verse":"1","text":"Chant des montées."},{"style":"b","verse":"2","text":""},{"style":"q","verse":"1","text":"Dans ma détresse, c'est à l'Eternel"},{"style":"q","verse":"1","text":"que j'ai crié, et il m'a répondu."},{"style":"b","verse":"2","text":""},{"style":"q","verse":"2","text":""},{"style":"v","verse":"2","text":"Eternel, délivre-moi des lèvres fausses,"},{"style":"q","verse":"2","text":"de la langue trompeuse!"},{"style":"b","verse":"3","text":""},{"style":"q","verse":"3","text":""},{"style":"v","verse":"3","text":"Que te donnera l'Eternel et que t'ajoutera-t-il,"},{"style":"q","verse":"3","text":"langue trompeuse?"},{"style":"q","verse":"4","text":""},{"style":"v","verse":"4","text":"Les flèches aiguës du guerrier"},{"style":"q","verse":"4","text":"avec des charbons ardents de genêt!"},{"style":"b","verse":"5","text":""},{"style":"q","verse":"5","text":""},{"style":"v","verse":"5","text":"Malheur à moi! J'ai dû séjourner à Méshec,"},{"style":"q","verse":"5","text":"habiter parmi les tentes de Kédar!"},{"style":"q","verse":"6","text":""},{"style":"v","verse":"6","text":"J'ai habité trop longtemps"},{"style":"q","verse":"6","text":"avec ceux qui détestent la paix."},{"style":"q","verse":"7","text":""},{"style":"v","verse":"7","text":"Je suis pour la paix, mais quand j'en parle,"},{"style":"q","verse":"7","text":"ils sont pour la guerre."}]