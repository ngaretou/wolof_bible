[{"style":"s","verse":"","text":"Louange universelle à Dieu"},{"style":"q","verse":"1","text":""},{"style":"v","verse":"1ouez","text":"l'Eternel, vous, toutes les nations,"},{"style":"q","verse":"1ouez","text":"célébrez-le, vous, tous les peuples\\f - \\fr 117.1 \\fq Louez… peuples: \\ft cité en \\xt Romains 15.11\\xt*.\\f*,"},{"style":"q","verse":"2","text":""},{"style":"v","verse":"2","text":"car sa bonté est grande envers nous"},{"style":"q","verse":"2","text":"et sa vérité dure éternellement!"},{"style":"q","verse":"2","text":"Louez l'Eternel!"}]