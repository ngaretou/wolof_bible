[{"style":"s","verse":"","text":"Bénédiction du foyer de l'homme fidèle"},{"style":"d","verse":"1","text":""},{"style":"v","verse":"1","text":"Chant des montées."},{"style":"b","verse":"2","text":""},{"style":"q","verse":"1","text":"Heureux tout homme qui craint l'Eternel,"},{"style":"q","verse":"1","text":"qui marche dans ses voies!"},{"style":"q","verse":"2","text":""},{"style":"v","verse":"2","text":"Tu profites alors du travail de tes mains,"},{"style":"q","verse":"2","text":"tu es heureux, tu prospères."},{"style":"q","verse":"3","text":""},{"style":"v","verse":"3","text":"Ta femme est comme une vigne porteuse de fruits"},{"style":"q","verse":"3","text":"dans ton foyer,"},{"style":"q","verse":"3","text":"tes fils sont comme des plants d'olivier"},{"style":"q","verse":"3","text":"autour de ta table."},{"style":"q","verse":"4","text":""},{"style":"v","verse":"4","text":"C'est ainsi qu'est béni"},{"style":"q","verse":"4","text":"l'homme qui craint l'Eternel."},{"style":"b","verse":"5","text":""},{"style":"q","verse":"5","text":""},{"style":"v","verse":"5","text":"L'Eternel te bénira de Sion,"},{"style":"q","verse":"5","text":"et tu verras le bonheur de Jérusalem"},{"style":"q","verse":"5","text":"tous les jours de ta vie,"},{"style":"q","verse":"6","text":""},{"style":"v","verse":"6","text":"tu verras les fils de tes fils."},{"style":"q","verse":"6","text":"Que la paix soit sur Israël!"}]